# Extraction mode: fake (deterministic fixtures, no key) | openrouter (real vision-LLM)
EXTRACTOR=fake

# Required when EXTRACTOR=openrouter. Model must support vision + structured outputs.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

DATABASE_URL=sqlite:///data/patient_card.db
UPLOAD_DIR=data/uploads
MAX_UPLOAD_MB=10
MAX_PDF_PAGES=5
LLM_TIMEOUT_S=120
